{
  "name": "dori-chat",
  "version": "0.1.0",
  "description": "Talk to Dori from any agent: typed SDK, CLI and skill for the Dori chat API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-yeongyu/dori-chat.git"
  },
  "bin": {
    "dori-chat": "./src/cli/main.ts"
  },
  "files": [
    "src",
    "skill",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/sdk/index.ts",
    "./protocol": "./src/shared/index.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "ky": "2.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
